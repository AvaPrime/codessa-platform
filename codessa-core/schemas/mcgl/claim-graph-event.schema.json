{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codessa.dev/schemas/mcgl/claim-graph-event.schema.json",
  "title": "MCGL Claim Graph Event",
  "description": "An append-only graph update derived from one or more canonical events. It preserves the source event references needed for replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_event_id", "operation", "claim", "derived_from", "extractor", "extractor_version", "created_at"],
  "properties": {
    "claim_event_id": { "type": "string", "pattern": "^cg_[A-Za-z0-9_-]{16,128}$" },
    "operation": { "type": "string", "enum": ["assert", "support", "oppose", "retract", "supersede"] },
    "claim": { "type": "object", "additionalProperties": false, "required": ["statement", "subject", "predicate"], "properties": { "statement": { "type": "string", "minLength": 1 }, "subject": { "type": "string", "minLength": 1 }, "predicate": { "type": "string", "minLength": 1 }, "object": { "type": "string" } } },
    "derived_from": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ce_[A-Za-z0-9_-]{16,128}$" } },
    "assessment_refs": { "type": "array", "items": { "type": "string", "pattern": "^ea_[A-Za-z0-9_-]{16,128}$" } },
    "extractor": { "type": "string", "minLength": 1 }, "extractor_version": { "type": "string", "minLength": 1 }, "created_at": { "type": "string", "format": "date-time" }
  }
}
